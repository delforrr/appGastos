{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Firefox Debugger",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "Start Frontend",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: Express Debugger",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "app.ts"],
      "cwd": "${workspaceFolder}/backend",
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": [
        "Backend: Express Debugger",
        "Frontend: Firefox Debugger"
      ]
    }
  ]
}
